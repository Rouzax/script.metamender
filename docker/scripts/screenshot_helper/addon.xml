<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.metamender.screenshots" name="MetaMender screenshots" version="1.0.0" provider-name="Rouzax">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <import addon="script.metamender" version="0.0.1"/>
    <!-- Kodi puts only the direct imports on the helper's path, and MetaMender's
         window modules import its providers. -->
    <import addon="script.module.requests" version="2.22.0"/>
    <import addon="script.module.imdbratings" version="1.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Development only: opens MetaMender windows with demo data for the docs screenshots</summary>
    <platform>all</platform>
  </extension>
</addon>
