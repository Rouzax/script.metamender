# Copy to .env and fill in your key. .env is gitignored.
TMDB_API_KEY=your_tmdb_api_key_here
# The share the test library's paths start with, and where this host mounts it
# (read-only). The live test and the matrix rig translate one into the other.
MEDIA_SHARE=smb://NAS/Data/
MEDIA_ROOT=/mnt/media/Data
