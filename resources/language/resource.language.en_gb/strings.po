# --- Backfill (32100-32149) ---

msgctxt "#32100"
msgid "Backfill"
msgstr ""

msgctxt "#32101"
msgid "Fields"
msgstr ""

msgctxt "#32102"
msgid "Enable ratings backfill"
msgstr ""

msgctxt "#32103"
msgid "Backfill missing or stale ratings and vote counts for movies, TV shows, and episodes."
msgstr ""

msgctxt "#32104"
msgid "Enable plots backfill"
msgstr ""

msgctxt "#32105"
msgid "Backfill missing plot summaries from TMDB or TheTVDB."
msgstr ""

msgctxt "#32106"
msgid "Enable episode title backfill"
msgstr ""

msgctxt "#32107"
msgid "Backfill missing episode titles from TMDB or TheTVDB. Generic titles such as \"Episode 3\" count as missing and are never written."
msgstr ""

msgctxt "#32108"
msgid "Enable certifications"
msgstr ""

msgctxt "#32109"
msgid "Fill and correct age certifications of movies and TV shows from TMDB and the national rating sites (FSK, BBFC, Medieraadet), in the rating system of the country chosen in the Certifications tab."
msgstr ""

msgctxt "#32110"
msgid "Enable credits backfill"
msgstr ""

msgctxt "#32111"
msgid "Backfill missing director, writer, and studio credits from TMDB."
msgstr ""

msgctxt "#32112"
msgid "Enable trailers backfill"
msgstr ""

msgctxt "#32113"
msgid "Backfill missing trailer URLs from TMDB."
msgstr ""

msgctxt "#32114"
msgid "Enable taglines backfill"
msgstr ""

msgctxt "#32115"
msgid "Backfill missing movie taglines from TMDB."
msgstr ""

msgctxt "#32116"
msgid "Enable details backfill"
msgstr ""

msgctxt "#32117"
msgid "Backfill missing supplementary details such as genres, premiere dates, and runtime from TMDB."
msgstr ""

msgctxt "#32120"
msgid "Freshness"
msgstr ""

msgctxt "#32125"
msgid "Staleness threshold (days)"
msgstr ""

msgctxt "#32126"
msgid "Content older than this many days is considered to have stable ratings. Only items with empty ratings are backfilled for older content."
msgstr ""

msgctxt "#32140"
msgid "Sources"
msgstr ""

msgctxt "#32141"
msgid "Configure sources"
msgstr ""

msgctxt "#32142"
msgid "Open the source configuration dialog to enable or disable backfill per video source and set the metadata language for each source."
msgstr ""

# --- Certifications (32200-32268) ---

msgctxt "#32200"
msgid "Certifications"
msgstr ""

msgctxt "#32201"
msgid "Certification format"
msgstr ""

msgctxt "#32202"
msgid "Country"
msgstr ""

msgctxt "#32203"
msgid "The rating system to fill in: its valid ratings, its prefix and how other countries' ratings are converted to it. Automatic uses the region of Kodi's interface language; certifications are skipped when that region has no rating system here."
msgstr ""

msgctxt "#32204"
msgid "Override certification prefix"
msgstr ""

msgctxt "#32205"
msgid "Use a custom prefix instead of the default for the selected country. Enable this if your Kodi skin expects a specific prefix format."
msgstr ""

msgctxt "#32206"
msgid "Custom prefix"
msgstr ""

msgctxt "#32207"
msgid "The prefix written before every certification, at most 8 characters (for example \"de:\" or \"Rated \"). Leave empty for no prefix."
msgstr ""

msgctxt "#32210"
msgid "Country scrapers"
msgstr ""

msgctxt "#32211"
msgid "Enable FSK lookup"
msgstr ""

msgctxt "#32212"
msgid "Ask the German FSK when TMDB has no certification. Its ratings count directly for Germany and are converted for the other countries."
msgstr ""

msgctxt "#32213"
msgid "Enable BBFC lookup"
msgstr ""

msgctxt "#32214"
msgid "Ask the British Board of Film Classification when TMDB has no certification. Its ratings count directly for the United Kingdom and are converted for the other countries."
msgstr ""

msgctxt "#32215"
msgid "Enable Medieraadet lookup"
msgstr ""

msgctxt "#32216"
msgid "Ask the Danish Media Council (Medieraadet) when TMDB has no certification. It rates films only. Its ratings count directly for Denmark and are converted for the other countries."
msgstr ""

msgctxt "#32220"
msgid "Correction"
msgstr ""

msgctxt "#32221"
msgid "Replace incorrect certifications"
msgstr ""

msgctxt "#32222"
msgid "Replace a certification from another country's system, such as \"Rated PG-13\" in a Dutch library. Ratings already in the selected country's system are kept, and ratings from an NFO file are never replaced. When disabled, only empty certifications are filled."
msgstr ""

msgctxt "#32230"
msgid "Fallback"
msgstr ""

msgctxt "#32231"
msgid "Apply certification when not found"
msgstr ""

msgctxt "#32232"
msgid "When no source has a certification for an item after a year of monthly rechecks, write the value below, so the item shows it was checked. When disabled, such items stay empty."
msgstr ""

msgctxt "#32233"
msgid "Not-found certification"
msgstr ""

msgctxt "#32234"
msgid "The value written when no source has a certification, exactly as entered (no country prefix). Common values: NR, Not Rated, Unrated."
msgstr ""

