msgid "Reset tracker: {} fields cleared"
msgstr ""

# --- Refetch schedule settings (32376-32380) ---

msgctxt "#32376"
msgid "Refresh schedule (days)"
msgstr ""

msgctxt "#32377"
msgid "Comma-separated list of ages in days at which recently-released content is re-fetched. Example: 7,30,90 re-fetches at one week, one month, and three months after release."
msgstr ""

msgctxt "#32378"
msgid "Reset tracker"
msgstr ""

msgctxt "#32379"
msgid "Clear all maturity tracking so every field is re-fetched from scratch on the next scan. Use this after a misconfiguration or when you want to force a full refresh."
msgstr ""

msgctxt "#32380"
msgid "Content age in days before metadata is treated as stable; older content is fetched once, newer content is refreshed on a schedule."
msgstr ""

# --- Text source settings (32390-32397) ---

msgctxt "#32390"
msgid "Text source order"
msgstr ""

msgctxt "#32391"
msgid "Which provider to ask first for TV show plots and episode titles and plots in the source folder's language. If the first has nothing, the second is asked. \"Follow the scraper\" asks first the provider whose Kodi scraper added the show or episode, so its wording stays; TMDB first when that cannot be told. Movies always use TMDB."
msgstr ""

msgctxt "#32392"
msgid "TMDB, then TheTVDB"
msgstr ""

msgctxt "#32393"
msgid "TheTVDB, then TMDB"
msgstr ""

msgctxt "#32398"
msgid "Follow the scraper"
msgstr ""

msgctxt "#32399"
msgid "Manage show and movie titles"
msgstr ""

msgctxt "#32400"
msgid "Replace show and movie titles with the title in the source folder's language from TMDB (and TheTVDB for shows), for example when a Dutch folder was scraped in English. Only a title the provider really has in that language is used; there is no fallback language. Titles from an NFO file are kept, and so are titles of items without a TMDB or IMDb id."
msgstr ""

msgctxt "#32396"
msgid "Fallback language order"
msgstr ""

msgctxt "#32397"
msgid "Which provider to ask first for TV show and episode text in a folder's fallback language, for folders that have one. Changing it fetches values filled from the fallback again."
msgstr ""
