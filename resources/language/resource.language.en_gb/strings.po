msgid "Notifications"
msgstr ""

msgctxt "#32311"
msgid "Show notifications"
msgstr ""

msgctxt "#32312"
msgid "Display a Kodi notification when a scan starts, finishes, or encounters errors."
msgstr ""

msgctxt "#32313"
msgid "Resume interrupted scans"
msgstr ""

msgctxt "#32314"
msgid "When enabled, a scan that was interrupted (for example, by a Kodi restart) will resume from where it left off instead of starting over."
msgstr ""

msgctxt "#32320"
msgid "Debugging"
msgstr ""

msgctxt "#32321"
msgid "Enable debug logging"
msgstr ""

msgctxt "#32322"
msgid "Write detailed diagnostic information to a log file in the addon data folder (addon_data/script.metamender/logs/)."
msgstr ""

msgctxt "#32330"
msgid "Maintenance"
msgstr ""

msgctxt "#32331"
msgid "Orphan retention (days)"
msgstr ""

msgctxt "#32332"
msgid "After a full scan, remove tracker entries for items not seen in the library for this many days (for example, deleted movies or episodes). Set to 0 to never remove them."
msgstr ""

