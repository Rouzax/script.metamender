# --- Refetch schedule settings (32376-32380) ---

msgctxt "#32376"
msgid "Refresh schedule (days)"
msgstr ""

msgctxt "#32377"
msgid "Comma-separated list of ages in days at which recently-released content is re-fetched. Example: 7,30,90 re-fetches at one week, one month, and three months after release."
msgstr ""

msgctxt "#32378"
msgid "Reset tracker"
msgstr ""

msgctxt "#32379"
msgid "Clear all maturity tracking so every field is re-fetched from scratch on the next scan. Use this after a misconfiguration or when you want to force a full refresh."
msgstr ""

msgctxt "#32380"
msgid "Content age in days before metadata is treated as stable; older content is fetched once, newer content is refreshed on a schedule."
msgstr ""

# --- Text source settings (32390-32397) ---

msgctxt "#32390"
msgid "Text source order"
msgstr ""

msgctxt "#32391"
msgid "Which provider to ask first for TV show plots and episode titles and plots in the source folder's language. If the first has nothing, the second is asked. Movies always use TMDB."
msgstr ""

msgctxt "#32392"
msgid "TMDB, then TheTVDB"
msgstr ""

msgctxt "#32393"
msgid "TheTVDB, then TMDB"
msgstr ""

msgctxt "#32394"
msgid "Fallback language"
msgstr ""

msgctxt "#32395"
msgid "Language code (for example en-US) used when no provider has a title or plot in the source folder's language. A fallback value only fills an empty field and never replaces existing text. Set it to the folder's own language to turn the fallback off."
msgstr ""

msgctxt "#32396"
msgid "Fallback language order"
msgstr ""

msgctxt "#32397"
msgid "Which provider to ask first for TV show and episode text in the fallback language."
msgstr ""
