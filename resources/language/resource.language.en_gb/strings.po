# --- General (32300-32349) ---

msgctxt "#32300"
msgid "General"
msgstr ""

msgctxt "#32301"
msgid "Schedule"
msgstr ""

msgctxt "#32302"
msgid "Scan interval (hours)"
msgstr ""

msgctxt "#32303"
msgid "Hours between automatic background scans. Lower values keep the library fresher but increase API usage."
msgstr ""

msgctxt "#32304"
msgid "API rate limit (seconds)"
msgstr ""

msgctxt "#32305"
msgid "Minimum delay between external API calls. Increase this if you experience rate limiting or throttling from providers."
msgstr ""

msgctxt "#32310"
msgid "Notifications"
msgstr ""

msgctxt "#32311"
msgid "Show notifications"
msgstr ""

msgctxt "#32312"
msgid "Display a Kodi notification when a scan starts, finishes, or encounters errors."
msgstr ""

msgctxt "#32313"
msgid "Resume interrupted scans"
msgstr ""

msgctxt "#32314"
msgid "When enabled, a scan that was interrupted (for example, by a Kodi restart) will resume from where it left off instead of starting over."
msgstr ""

msgctxt "#32320"
msgid "Debugging"
msgstr ""

msgctxt "#32321"
msgid "Enable debug logging"
msgstr ""

msgctxt "#32322"
msgid "Write detailed debug information to a log file in the addon data folder. Useful for troubleshooting but increases disk usage."
msgstr ""
