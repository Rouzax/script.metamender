msgctxt "#32001"
msgid "Providers"
msgstr ""

msgctxt "#32010"
msgid "TMDB"
msgstr ""

msgctxt "#32011"
msgid "TMDB API key"
msgstr ""

msgctxt "#32012"
msgid "API key for The Movie Database. Required for most lookups. Get one free at themoviedb.org."
msgstr ""

