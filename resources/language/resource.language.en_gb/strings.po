msgctxt "#32300"
msgid "General"
msgstr ""

msgctxt "#32301"
msgid "Schedule"
msgstr ""

msgctxt "#32302"
msgid "Scan interval (hours)"
msgstr ""

msgctxt "#32303"
msgid "Hours between automatic background scans. Lower values keep the library fresher but increase API usage."
msgstr ""

msgctxt "#32304"
msgid "API rate limit (seconds)"
msgstr ""

msgctxt "#32305"
msgid "Minimum delay between external API calls. Increase this if you experience rate limiting or throttling from providers."
msgstr ""

